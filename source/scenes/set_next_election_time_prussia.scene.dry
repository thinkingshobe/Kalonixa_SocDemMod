title: next election time
on-arrival: next_election_time_kalixa = time+3 if next_election_time_kalixa >= time+3; next_election_month_kalixa = month + 3 if next_election_time_kalixa >= time+3; next_election_year_kalixa = year if next_election_time_kalixa >= time+3; next_election_year_kalixa += 1 if next_election_month_kalixa > 12; next_election_month_kalixa -= 12 if next_election_month_kalixa > 12; 
