on-arrival: {!

Q.cvp_kvp_formed = 1;
Q.kvp_formed = 0;

Q.workers_z += Q.workers_kvp;

Q.new_middle_z += Q.new_middle_kvp;

Q.old_middle_z += Q.old_middle_kvp;

Q.rural_z += Q.rural_kvp;

Q.unemployed_z += Q.unemployed_kvp;

Q.catholics_z += Q.catholics_kvp;

Q.bourgeois_parliament_kvp = 0;

Q.z_r = Math.round((Q.z_r + Q.kvp_r) * 10) / 10;
Q.z_r_kalixa = Math.round((Q.z_r_kalixa + Q.kvp_r_kalixa) * 10) / 10;
Q.z_relation -= 20;

Q.kvp_r = 0;
Q.kvp_r_kalixa = 0;
Q.kvp_votes = 0;
Q.kvp_normalized = 0;

Q.parties = Q.parties.filter(party => party !== 'kvp');

if (Q.lvp_formed) {
    Q.weimar_coalition = parseFloat((Q.egk_r + Q.lvp_r + Q.z_r - Q.bvp_r).toFixed(1));
} else {
    Q.weimar_coalition = parseFloat((Q.egk_r + Q.ddp_r + Q.z_r - Q.bvp_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.social_liberal_coalition = parseFloat((Q.egk_r + Q.lvp_r).toFixed(1));
} else {
    Q.social_liberal_coalition = parseFloat((Q.egk_r + Q.ddp_r).toFixed(1));
}

Q.social_catholic_coalition = parseFloat((Q.egk_r + Q.z_r - Q.bvp_r).toFixed(1));

if (Q.lvp_formed) {
    Q.grand_coalition = parseFloat((Q.egk_r + Q.lvp_r + Q.z_r).toFixed(1));
} else {
    Q.grand_coalition = parseFloat((Q.egk_r + Q.ddp_r + Q.z_r + Q.dvp_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.bourgeois_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r).toFixed(1));
} else {
    Q.bourgeois_coalition = parseFloat((Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r + Q.dnvp_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.z_r + Q.ddp_r + Q.dvp_r + Q.other_r + Q.dnvp_r + Q.kvp_r).toFixed(1));
} else if (!Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
} else {
    Q.center_right_coalition = parseFloat((Q.z_r + Q.ddp_r + Q.dvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.right_coalition = parseFloat((Q.z_r + Q.lvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
} else {
    Q.right_coalition = parseFloat((Q.z_r + Q.dvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
}

if (Q.dnvp_ideology === "Moderate") {
    Q.far_right_coalition = parseFloat((Q.dnf_r + Q.nsdap_r).toFixed(1));
} else {
    Q.far_right_coalition = parseFloat((Q.dnvp_r + Q.nsdap_r).toFixed(1));
}

if (Q.dvp_leader == "Dingeldey" && Q.dvp_ideology == "Right" && Q.dvp_right - Q.dvp_left >= 15 || Q.hugenberg_dvp) {
    Q.far_right_coalition = parseFloat((Q.far_right_coalition + Q.dvp_r).toFixed(1));
}

Q.left_coalition = parseFloat((Q.egk_r + Q.kpd_r + Q.sapd_r).toFixed(1));

if (Q.lvp_formed) {
    Q.popular_front_coalition = parseFloat((Q.egk_r + Q.kpd_r + Q.z_r - Q.bvp_r + Q.sapd_r).toFixed(1));
} else if (Q.liberal_parliament == 0 && Q.bourgeois_parliament_ddp == 0) {
    Q.popular_front_coalition = parseFloat((Q.egk_r + Q.kpd_r + Q.z_r + Q.ddp_r - Q.bvp_r + Q.sapd_r).toFixed(1));
} else if (Q.liberal_parliament == 1 || Q.bourgeois_parliament_ddp == 1) {
    Q.popular_front_coalition = parseFloat((Q.egk_r + Q.kpd_r + Q.z_r - Q.bvp_r + Q.sapd_r).toFixed(1));
}

if (Q.dnvp_ideology === "Moderate") {
    Q.anti_democratic_coalition = parseFloat((Q.kpd_r + Q.nsdap_r + Q.dnf_r).toFixed(1));
} else {
    Q.anti_democratic_coalition = parseFloat((Q.kpd_r + Q.nsdap_r + Q.dnvp_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.neo_weimar_coalition = parseFloat((Q.egk_r + Q.lvp_r + Q.z_r + Q.other_r).toFixed(1));
} else {
    Q.neo_weimar_coalition = parseFloat((Q.egk_r + Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.egk_r + Q.lvp_r + Q.z_r + Q.other_r + Q.kvp_r).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.egk_r + Q.ddp_r + Q.z_r + Q.dvp_r + Q.other_r + Q.dnvp_r + Q.kvp_r).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.cordon_sanitaire = parseFloat((Q.egk_r + Q.z_r + Q.lvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
} else {
    Q.cordon_sanitaire = parseFloat((Q.egk_r + Q.z_r + Q.ddp_r + Q.dvp_r + Q.other_r + Q.dnvp_r).toFixed(1));
}

Q.hitler_right_coalition = parseFloat((Q.z_r + Q.nsdap_r).toFixed(1));

Q.goerdeler_right_coalition = parseFloat((Q.z_r + Q.dvp_r + Q.lvp_r + Q.other_r + Q.kvp_r + Q.dnvp_r + Q.dnf_r).toFixed(1));

if (Q.lvp_formed) {
    Q.progressive_coalition = parseFloat((Q.egk_r + Q.kpd_r + (Q.lvp_r / 3) + Q.sapd_r).toFixed(1));
} else {
    Q.progressive_coalition = parseFloat((Q.egk_r + Q.kpd_r + Q.ddp_r + Q.sapd_r).toFixed(1));
}

if (Q.dnef_formed) {
    Q.schleicher_right_coalition = parseFloat((Q.dnef_r + Q.lvp_r + Q.dvp_r + Q.ddp_r + Q.z_r + Q.other_r + Q.kvp_r + Q.dnvp_r + Q.dnf_r + Q.dsu_r).toFixed(1));
    Q.schleicher_left_coalition = parseFloat((Q.dnef_r + Q.egk_r + Q.lvp_r + Q.dvp_r + Q.ddp_r + Q.z_r).toFixed(1));
}

if (Q.lvp_formed) {
    Q.weimar_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.lvp_r_kalixa + Q.z_r_kalixa ).toFixed(1));
} else {
    Q.weimar_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.ddp_r_kalixa + Q.z_r_kalixa).toFixed(1));
}

if (Q.lvp_formed) {
    Q.social_liberal_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.lvp_r_kalixa).toFixed(1));
} else {
    Q.social_liberal_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.ddp_r_kalixa).toFixed(1));
}

Q.social_catholic_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.z_r_kalixa).toFixed(1));

if (Q.lvp_formed) {
    Q.grand_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.lvp_r_kalixa + Q.z_r_kalixa).toFixed(1));
} else {
    Q.grand_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.ddp_r_kalixa + Q.z_r_kalixa + Q.dvp_r_kalixa).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.bourgeois_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.lvp_r_kalixa + Q.other_r_kalixa + Q.kvp_r_kalixa).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.bourgeois_coalition_kalixa = parseFloat((Q.ddp_r_kalixa + Q.z_r_kalixa + Q.dvp_r_kalixa + Q.other_r_kalixa + Q.kvp_r_kalixa).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.bourgeois_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.lvp_r_kalixa + Q.other_r_kalixa).toFixed(1));
} else {
    Q.bourgeois_coalition_kalixa = parseFloat((Q.ddp_r_kalixa + Q.z_r_kalixa + Q.dvp_r_kalixa + Q.other_r_kalixa).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.lvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r_kalixa + Q.kvp_r_kalixa).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.center_right_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.ddp_r_kalixa + Q.dvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r_kalixa + Q.kvp_r_kalixa).toFixed(1));
} else if (!Q.kvp_formed && Q.lvp_formed) {
    Q.center_right_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.lvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r_kalixa).toFixed(1));
} else {
    Q.center_right_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.ddp_r_kalixa + Q.dvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r_kalixa).toFixed(1));
}

if (Q.lvp_formed) {
    Q.right_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.lvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r_kalixa).toFixed(1));
} else {
    Q.right_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.dvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r_kalixa).toFixed(1));
}

if (Q.dnvp_ideology === "Moderate") {
    Q.far_right_coalition_kalixa = parseFloat((Q.dnf_r_kalixa + Q.nsdap_r_kalixa).toFixed(1));
} else {
    Q.far_right_coalition_kalixa = parseFloat((Q.dnvp_r_kalixa + Q.nsdap_r_kalixa).toFixed(1));
}

if (Q.dvp_leader == "Dingeldey" && Q.dvp_ideology == "Right" && Q.dvp_right - Q.dvp_left >= 15 || Q.hugenberg_dvp) {
    Q.far_right_coalition_kalixa = parseFloat((Q.far_right_coalition_kalixa + Q.dvp_r_kalixa).toFixed(1));
}

Q.left_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.kpd_r_kalixa + Q.sapd_r_kalixa).toFixed(1));

if (Q.lvp_formed) {
    Q.popular_front_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.kpd_r_kalixa + Q.z_r_kalixa + Q.sapd_r_kalixa).toFixed(1));
} else if (Q.liberal_parliament == 0) {
    Q.popular_front_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.kpd_r_kalixa + Q.z_r_kalixa + Q.ddp_r_kalixa + Q.sapd_r_kalixa).toFixed(1));
} else if (Q.liberal_parliament == 1) {
    Q.popular_front_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.kpd_r_kalixa + Q.z_r_kalixa + Q.sapd_r_kalixa).toFixed(1));
}

if (Q.dnvp_ideology === "Moderate") {
    Q.anti_democratic_coalition_kalixa = parseFloat((Q.kpd_r_kalixa + Q.nsdap_r_kalixa + Q.dnf_r_kalixa).toFixed(1));
} else {
    Q.anti_democratic_coalition_kalixa = parseFloat((Q.kpd_r_kalixa + Q.nsdap_r_kalixa + Q.dnvp_r_kalixa).toFixed(1));
}

if (Q.lvp_formed) {
    Q.neo_weimar_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.lvp_r_kalixa + Q.z_r_kalixa + Q.other_r_kalixa).toFixed(1));
} else {
    Q.neo_weimar_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.ddp_r_kalixa + Q.z_r_kalixa + Q.dvp_r_kalixa + Q.other_r_kalixa).toFixed(1));
}

if (Q.kvp_formed && Q.lvp_formed) {
    Q.cordon_sanitaire_kalixa = parseFloat((Q.egk_r_kalixa + Q.lvp_r_kalixa + Q.z_r_kalixa + Q.other_r_kalixa + Q.kvp_r_kalixa).toFixed(1));
} else if (Q.kvp_formed && !Q.lvp_formed) {
    Q.cordon_sanitaire_kalixa = parseFloat((Q.egk_r_kalixa + Q.ddp_r_kalixa + Q.z_r_kalixa + Q.dvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r_kalixa + Q.kvp_r_kalixa).toFixed(1));
} else if (Q.lvp_formed && !Q.kvp_formed) {
    Q.cordon_sanitaire_kalixa = parseFloat((Q.egk_r_kalixa + Q.z_r_kalixa + Q.lvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r_kalixa).toFixed(1));
} else {
    Q.cordon_sanitaire_kalixa = parseFloat((Q.egk_r_kalixa + Q.z_r_kalixa + Q.ddp_r_kalixa + Q.dvp_r_kalixa + Q.other_r_kalixa + Q.dnvp_r).toFixed(1));
}

// Q.hitler_right_coalition_kalixa = parseFloat((Q.z_r_kalixa + Q.dnvp_r_kalixa + Q.nsdap_r_kalixa).toFixed(1));

if (Q.lvp_formed) {
    Q.progressive_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.kpd_r_kalixa + (Q.lvp_r_kalixa / 2) + Q.sapd_r_kalixa).toFixed(1));
} else {
    Q.progressive_coalition_kalixa = parseFloat((Q.egk_r_kalixa + Q.kpd_r_kalixa + Q.ddp_r_kalixa + Q.sapd_r_kalixa).toFixed(1));
}

if (Q.dnef_formed) {
    Q.schleicher_right_coalition_kalixa = parseFloat((Q.dnef_r_kalixa + Q.lvp_r_kalixa + Q.dvp_r_kalixa + Q.ddp_r_kalixa + Q.z_r_kalixa + Q.other_r_kalixa + Q.kvp_r_kalixa + Q.dnvp_r_kalixa + Q.dnf_r_kalixa + Q.dsu_r_kalixa).toFixed(1));
    Q.schleicher_left_coalition_kalixa = parseFloat((Q.dnef_r_kalixa + Q.egk_r_kalixa + Q.lvp_r_kalixa + Q.ddp_r_kalixa + Q.z_r_kalixa).toFixed(1));
}

if (Q.kpd_relation >= 30 && Q.sapd_formed == 1) {
    Q.weimar_coalition_kalixa += Q.sapd_r_kalixa;
}
!}
